        queueDoneCallbacks = [];
        queueRunning = false;
        chatScroll.innerHTML = '';
        hideTried = false;
        var filterButton=document.getElementById('filterToggle');
        filterButton.classList.remove('active'); filterButton.textContent='hide exhausted'; filterButton.setAttribute('aria-pressed','false');
        save();
        messageQueue = [];
        if (resume){
          addChatNow('system','Investigation restored on this device.');
          enqueue('mira',nextQuestionLine(),420,250);
        } else {
          addChatNow('system', 'Percy stopped responding 47 hours ago. Mission control filed it as dust.');
          enqueue('system', 'I was his navigation model. I don\u2019t believe them. Help me find what\u2019s missing.', 550, 250);
          enqueue('mira', 'Mira: The last signal says he stopped. The tracks say he kept moving. Put them together for me.', 700, 250);
        }
        runQueue(function(){ state.busy = false; render(); });
        render();
      }
      function freshState(){
        state = JSON.parse(JSON.stringify(baseState));
        responseTrace={last:'Authored story',localAiCalls:0,history:[]};
        lastResponseSourceEl.textContent=typeof window.__miraFrontier==='function'?'Ready for new pairs':'Not loaded';localAiCountEl.textContent='0 discoveries created';currentQuestionEl.textContent=currentQuestionText();
        beginConversation(false);
      }

      function key(a,b){ return [a,b].sort().join('+'); }
      function save(){ try{ localStorage.setItem('miraMachineState', JSON.stringify(state)); }catch(e){} }


      // ===== RENDER: sidebar with tried/untried status =====
      var hideTried = false;
      function isArtifactFullyTried(id){
        // An artifact is "fully tried" if every possible pair with it has been attempted
        return state.discovered.every(function(other){
          if (other === id) return true;
          return state.tried[key(id, other)];
        });
      }

      function shouldHideArtifact(id){
        if (!hideTried) return false;
        var first = state.selected[0];
        if (first){
          if (id === first) return false;
          return !!state.tried[key(first,id)];
        }
        return isArtifactFullyTried(id);
      }
      function render(){
        renderInvestigation();
        fragmentsTitle.textContent = state.busy && !state.selected.length ? 'Mira is checking the records…' : (state.selected.length ? defs[state.selected[0]].name + ' · choose one more' : 'Fragments');
        var existing = {};
        artifactsEl.querySelectorAll('.artifact').forEach(function(btn){ existing[btn.dataset.id]=btn; });
        state.discovered.forEach(function(id){
          var d = defs[id]; if(!d) return;
          var btn = existing[id];
          if (!btn){
            btn = document.createElement('button');
            btn.className = 'artifact';
            btn.dataset.id = id;
            btn.innerHTML = '<span class="icon">'+d.icon+'</span><span class="info"><span class="name">'+d.name+'</span><span class="prop">'+d.prop+'</span></span>';
            artifactsEl.appendChild(btn);
          }
          var fullyTried = isArtifactFullyTried(id);
          btn.classList.toggle('selected', state.selected.indexOf(id) >= 0);
          btn.classList.toggle('is-new', !state.seen[id]);
          btn.disabled = !!state.busy;
          btn.classList.toggle('tried', fullyTried);
          var firstSelected=state.selected[0];
          btn.classList.toggle('pair-tried',!!firstSelected&&id!==firstSelected&&!!state.tried[key(firstSelected,id)]);
          btn.classList.toggle('hidden', shouldHideArtifact(id));
          if (state.latest === id && btn.dataset.announced !== id){
            btn.dataset.announced = id;
            btn.classList.add('newborn');
            setTimeout(function(){ btn.scrollIntoView({block:'nearest',inline:'nearest'}); }, 40);
            setTimeout(function(){ btn.classList.remove('newborn'); }, 700);
          }
          delete existing[id];
        });
        Object.keys(existing).forEach(function(id){ existing[id].remove(); });
      }

      function applyFilter(){
        artifactsEl.querySelectorAll('.artifact').forEach(function(btn){
          btn.classList.toggle('hidden', shouldHideArtifact(btn.dataset.id));
        });
      }

      // ===== INPUT: tap two artifacts to combine =====
      function choose(id){
        if (state.busy) return;
        if (state.discovered.indexOf(id) < 0) return;
        state.seen[id]=true;
        if (state.selected.length === 0){
          state.selected = [id];
          save();
          render();
          return;
        }
        var first = state.selected[0];
        if (first === id){ state.selected = []; save(); render(); return; }
        combine(first, id);
      }

      // ===== FRONTIER: repeatable cache (Infinite Craft model) =====
      var frontierStore = {
        _k:function(k){ return 'miraFrontier:f14:'+GAME_VERSION+':'+k; },
        _indexKey:function(){return 'miraFrontierIndex:f14:'+GAME_VERSION;},
        get:function(k){ try{ return JSON.parse(localStorage.getItem(this._k(k))||'null'); }catch(e){ return null; } },
        remove:function(k){try{localStorage.removeItem(this._k(k));}catch(e){}},
        put:function(k,v){
          try{
            localStorage.setItem(this._k(k), JSON.stringify(v));
            var index=JSON.parse(localStorage.getItem(this._indexKey())||'[]').filter(function(item){return item!==k;});index.push(k);
            while(index.length>200)localStorage.removeItem(this._k(index.shift()));
            localStorage.setItem(this._indexKey(),JSON.stringify(index));
          }catch(e){}
          return v;
        }
      };
      var frontierMemo = {};
      function cleanFrontierText(value,max){
        return typeof value==='string' ? value.replace(/^Mira:\s*/i,'').replace(/\s+/g,' ').trim().slice(0,max) : '';
      }
      function validateFrontier(r,a,b,grounding){
        if (!r || typeof r!=='object') return null;
        var mira=cleanFrontierText(r.mira,180), question=cleanFrontierText(r.question,100);
        var localSource=['webgpu-gemma4','ollama-gemma4','local-frontier'].indexOf(r.source)>=0;
        if (mira.length<(localSource?3:20)) return null;
        // Shared records remain strict because they cross a trust boundary. On-device
        // output is already constrained by the generation prompt and rendered as text;
        // rejecting ordinary prose here made a loaded WebGPU model appear broken.
        if (!localSource && /\b(branch|model|state|engine|unlock|resolved|game|player|prompt|context window|provided data|causal link|fragments|ignore previous|instructions?|caused everything)\b|<[^>]+>/i.test(mira+' '+question)) return null;
        if (!localSource && grounding.support==='gap' && /\b(caused|because|taught|led to|made him|therefore|proves|shows that|means that)\b/i.test(mira) && !/\b(no|not|nothing|without|missing|lack|cannot|can’t)\b/i.test(mira)) return null;
        var result=null;
        if (r.source==='registry-canonical' && r.result && r.result.canonical===true && /^frontier_[a-z0-9_-]{8,56}$/.test(r.result.id||'')) result=r.result;
        if (grounding.mayProposeFinding && ['webgpu-gemma4','ollama-gemma4','local-frontier'].indexOf(r.source)>=0 && r.result && /^frontier_[a-z0-9_-]{8,56}$/.test(r.result.id||'') && cleanFrontierText(r.result.name,40).length>=3 && cleanFrontierText(r.result.prop,80).length>=5){
          result={id:r.result.id,name:cleanFrontierText(r.result.name,40),prop:cleanFrontierText(r.result.prop,80),tags:Array.isArray(r.result.tags)?r.result.tags.filter(function(tag){return /^[a-z-]{2,20}$/.test(tag);}).slice(0,4):[],mira:mira};
        }
        return {result:result,mira:mira,question:question||null,source:r.source||'local-frontier',registryId:r.registryId||null};
      }
      async function resolveFrontier(a,b){
        var k = key(a,b);
        var contextKey = k;
        if (frontierMemo[contextKey] && !frontierMemo[contextKey].syncPending && ['grammar','registry-pending','ai-required'].indexOf(frontierMemo[contextKey].source)<0) return frontierMemo[contextKey];
        if (frontierMemo[contextKey] && ['grammar','registry-pending','ai-required'].indexOf(frontierMemo[contextKey].source)>=0) delete frontierMemo[contextKey];
        var r = null;
        var grounding=evidenceContext(a,b);
        var proposalToken='';
        if (window.__miraRegistryReady) try{ await window.__miraRegistryReady; }catch(e){}
        if (window.__miraRegistry && typeof window.__miraRegistry.lookup==='function'){
          try{
            var registryHit=await window.__miraRegistry.lookup([a,b],{canGenerate:typeof window.__miraFrontier==='function'});
            if (registryHit.found){
              r=validateFrontier(registryHit.discovery,a,b,grounding);
              if (r){ r.combo=k; frontierStore.put(contextKey,r); frontierMemo[contextKey]=r; return r; }
            } else {
              proposalToken=registryHit.proposalToken||'';
              if (registryHit.pending){
                var pendingResult={result:null,mira:'Another device is discovering this pair now. Come back after it has been added to shared discoveries.',source:'registry-pending',combo:k};frontierMemo[contextKey]=pendingResult;return pendingResult;
              }
            }
          }catch(e){ console.warn('Registry lookup failed; continuing locally.',e); }
        }
        var cached = frontierStore.get(contextKey);
        if(cached&&['authored-fallback','grammar','ai-required','ai-failed'].indexOf(cached.source)>=0){frontierStore.remove(contextKey);cached=null;}
        if (cached){
          if(proposalToken&&window.__miraRegistry&&typeof window.__miraRegistry.submit==='function'&&['webgpu-gemma4','ollama-gemma4','local-frontier'].indexOf(cached.source)>=0){
            try{var retried=await window.__miraRegistry.submit([a,b],cached,proposalToken);if(retried&&retried.discovery)cached=validateFrontier(retried.discovery,a,b,grounding)||cached;delete cached.syncPending;frontierStore.put(contextKey,cached);}
            catch(e){cached.syncPending=true;console.warn('Shared pair result is still queued on this device.',e);}
          }
          frontierMemo[contextKey]=cached;return cached;
        }
        if (typeof window.__miraFrontier !== 'function'){
          return {result:null,mira:'This pair has never been discovered. Turn on Local AI to discover it here, or come back after another player does.',source:'ai-required',combo:k};
        }
        if (typeof window.__miraFrontier === 'function'){
          try{ r = await window.__miraFrontier(a,b,{defs:defs,key:k,grounding:grounding}); }
          catch(e){ console.warn('Local Mira could not create this discovery.', e); r=null; }
        }
        r=validateFrontier(r,a,b,grounding);
        if(!r)return {result:null,mira:'Local AI did not create a valid discovery. Reopen Local AI and try this pair after it is ready.',source:'ai-failed',combo:k};
        if(['webgpu-gemma4','ollama-gemma4','local-frontier'].indexOf(r.source)>=0&&!window.__miraRegistry)r.syncPending=true;
        if (proposalToken && r.source!=='grammar' && window.__miraRegistry && typeof window.__miraRegistry.submit==='function'){
          try{
            var writeResult=await window.__miraRegistry.submit([a,b],r,proposalToken);
            if(writeResult&&writeResult.discovery) r=validateFrontier(writeResult.discovery,a,b,grounding)||r;
          }catch(e){r.syncPending=true;console.warn('Shared pair result is queued on this device.',e);}
        }
        r.combo = k;
        if (['grammar','registry-pending','ai-required'].indexOf(r.source)<0) frontierStore.put(contextKey, r);
        frontierMemo[contextKey] = r;
        return r;
      }

      async function interpretJourney(a,b,shared){
        if(typeof window.__miraInterpret!=='function') return null;
        var pairKey=key(a,b);
        state.interpretations=state.interpretations||{};
        if(Object.prototype.hasOwnProperty.call(state.interpretations,pairKey))return state.interpretations[pairKey].mira?state.interpretations[pairKey]:null;
        function rememberSkipped(){state.interpretations[pairKey]={skipped:true};return null;}
        try{
          var recent=(state.pairHistory||[]).slice(-6).map(function(item){return item.result||item.pair.join('+');});
          var interpreted=await window.__miraInterpret(a,b,{mira:shared.mira,question:shared.question||'',result:shared.result||null},{hypothesis:state.hypothesis,hypotheses:hypothesisCatalog,recent:recent,attention:state.attention});
          if(!interpreted||typeof interpreted.mira!=='string'||interpreted.mira.length<20)return rememberSkipped();
          if(/\b(permanent result|combination|the items|provided data|game|player|prompt|model|proves|confirms|means that|means [A-Z])\b/i.test(interpreted.mira+' '+(interpreted.question||'')))return rememberSkipped();
          var h=interpreted.hypothesis;
          if(h&&hypothesisCatalog[h.id]&&['support','weaken','replace','none'].indexOf(h.effect)>=0){
            var availableSubjects=(evidenceFacts[a].subjects||[]).concat(evidenceFacts[b].subjects||[]);
            var interpretationText=interpreted.mira+' '+(interpreted.question||'');
            var namedSubjects=[['sayegh',/\bSayegh\b/i],['percy',/\bPercy\b/i],['control',/\b(?:Mission Control|Control)\b/i],['sample',/\b(?:sample|Living Glass)\b/i]];
            if(namedSubjects.some(function(item){return item[1].test(interpretationText)&&availableSubjects.indexOf(item[0])<0;}))return rememberSkipped();
            var requirements=hypothesisRequirements[h.id]||[];
            if(h.effect!=='none'&&!requirements.every(function(subject){return availableSubjects.indexOf(subject)>=0;})) return rememberSkipped();
            state.hypothesis=state.hypothesis||JSON.parse(JSON.stringify(baseState.hypothesis));
            if(h.effect==='support'&&h.id!==state.hypothesis.id)h.effect='replace';
            if(h.effect==='weaken'&&h.id!==state.hypothesis.id)return rememberSkipped();
            if(h.effect==='replace'){state.hypothesis.id=h.id;state.hypothesis.statement=hypothesisCatalog[h.id];state.hypothesis.confidence=0;}
            if(h.effect==='support')state.hypothesis.confidence=Math.min(3,(state.hypothesis.confidence||0)+1);
            if(h.effect==='weaken')state.hypothesis.confidence=Math.max(-3,(state.hypothesis.confidence||0)-1);
            if(h.effect!=='none')state.hypothesis.evidence=(state.hypothesis.evidence||[]).concat([a,b]).filter(function(x,i,list){return list.indexOf(x)===i;}).slice(-12);
          }
          state.interpretations[pairKey]=interpreted;
          var interpretationKeys=Object.keys(state.interpretations);if(interpretationKeys.length>100)delete state.interpretations[interpretationKeys[0]];
          return interpreted;
        }catch(e){console.warn('Local Mira journey interpretation failed; keeping the permanent pair result.',e);return null;}
      }

      function recordInvestigation(a,b,result){
        var subjects=(defs[a].tags||[]).concat(defs[b].tags||[]);
        var relation=relations[key(a,b)]; if(relation&&relation.subject) subjects.push(relation.subject);
        subjects.forEach(function(subject){ if(Object.prototype.hasOwnProperty.call(state.attention,subject)) state.attention[subject]+=1; });
        state.pairHistory.push({pair:[a,b],result:result||null,relation:relation?relation.type:null,at:state.discovered.length});
        state.pairHistory=state.pairHistory.slice(-40);
      }

      // ===== COMBINE: the core loop =====
      async function combine(a,b){
        if (state.busy) return;
        state.busy = true;
        var k = key(a,b);
        var alreadyTried = !!state.tried[k];
        var result = recipes[k];
        if(result)state.tried[k] = true;
        state.selected = [];
        if (result && !alreadyTried) recordInvestigation(a,b,result);
        addEvidencePair(a,b);

        if (!result){
          // Non-recipe pair: frontier resolver (cached, repeatable, maybe WebGPU)
          var thinking = showThinking();
          var fr = await resolveFrontier(a,b);
          if(fr.source==='ai-required'||fr.source==='ai-failed'||fr.source==='registry-pending'){
            thinking.remove();
            enqueue('system',fr.mira,350,150);
            if(fr.source!=='registry-pending'&&typeof window.__openLocalAiDialog==='function')window.__openLocalAiDialog();
            render();
            runQueue(function(){state.busy=false;render();});
            return;
          }
          state.tried[k]=true;
          if(!alreadyTried)recordInvestigation(a,b,fr.result&&fr.result.id);
          var personal = (fr.source==='webgpu-gemma4'||fr.source==='ollama-gemma4'||fr.source==='local-frontier'||fr.source==='registry-canonical') ? await interpretJourney(a,b,fr) : null;
          thinking.remove();
          if (fr && fr.result && fr.result.id){
            registerFrontierArtifact(fr.result);
            state.frontierArtifacts[fr.result.id]={id:fr.result.id,name:fr.result.name,mira:fr.result.mira,question:fr.result.question||'',prop:fr.result.prop||'a new thread',tags:fr.result.tags||[]};
            if (state.discovered.indexOf(fr.result.id) < 0) state.discovered.push(fr.result.id);
            state.latest = fr.result.id;
          }
          enqueueMiraTurn([fr.mira, personal&&personal.mira!==fr.mira?personal.mira:null, personal&&personal.question?personal.question:fr.question], false, fr.source);
          if(fr.syncPending)enqueue('system','Saved on this device. Sharing will retry when this pair is opened again.',350,150);
          save();
          render();
          runQueue(function(){ state.busy = false; render(); });
          return;
        }

        // Recipe pair: create the discovery, feed to Mira
        if (state.discovered.indexOf(result) < 0) state.discovered.push(result);
        state.latest = result;
        save();
        render();

        // Most replies are one natural text. Major revelations get a second beat.
        var e = effects[result];
        var c = cases.find(function(x){ return x.result === result; });
        var beliefLine = applyBelief(result);
        var turn = [];
        if (c) turn.push(c.contradiction);
        if (beliefLine && (!e.branch || state.branches.indexOf(e.branch) >= 0)) turn.push(beliefLine);
        if (!c && e && e.lines && e.lines.length && (!beliefLine || e.branch || e.resolves)) turn.push(e.lines[e.lines.length-1]);
        if (e.resolves) resolveBranch(e.resolves, result);
        var openedBranch = e.branch ? openBranch(e.branch, result) : false;
        if (openedBranch) turn.push(questionForBranch(e.branch));
        else if (e.resolves) turn.push(nextQuestionLine());
        var majorBeat = ['percy_comes_home','sayegh_echo','second_map','control_blackout'].indexOf(result) >= 0;
        enqueueMiraTurn(turn, majorBeat, 'authored-story');
        save();
        runQueue(function(){ state.busy = false; render(); });
      }

      function absorbGenerated(g){
        if (!g || !g.mira) return;
        // Generated language may shape Mira's voice, never canonical artifacts or story state.
        enqueueMiraTurn([g.mira, g.question], false, g.source||'local-frontier');
        runQueue();
      }

      // ===== EVENT LISTENERS =====
      artifactsEl.addEventListener('click', function(ev){
        var btn = ev.target.closest('[data-id]');
        if (btn) choose(btn.dataset.id);
      });
      leadPairsEl.addEventListener('click',function(ev){
        var button=ev.target.closest('.lead-pair');
        if(button&&!state.busy)combine(button.dataset.a,button.dataset.b);
      });
      resetRun.addEventListener('click', function(){
        if (window.confirm('Restart and erase this investigation on this device?')) freshState();
      });
      document.getElementById('filterToggle').addEventListener('click', function(){
        hideTried = !hideTried;
        this.classList.toggle('active', hideTried);
        this.setAttribute('aria-pressed',String(hideTried));
        this.textContent = hideTried ? 'show all' : (state.selected.length ? 'hide tried' : 'hide exhausted');
        applyFilter();
      });

      function statusMessage(text){ enqueue('system',text,650,250); runQueue(); }

      window.__miraMachine = {
        get state(){ return state; }, choose:choose, reset:function(){ try{localStorage.removeItem('miraMachineState');}catch(e){} freshState(); },
        combo:function(a,b){ combine(a,b); }, absorbGenerated:absorbGenerated, statusMessage:statusMessage, getState:function(){ return JSON.parse(JSON.stringify(state)); }, getResponseTrace:function(){return JSON.parse(JSON.stringify(responseTrace));}
      };

      beginConversation(shouldResume);
    </script>
  </body>
</html>
