---
const registryEndpoint = import.meta.env.PUBLIC_MIRA_REGISTRY_ENDPOINT || '';
const basePath = import.meta.env.BASE_URL;
let registryPublicKey = null;
try {
  registryPublicKey = import.meta.env.PUBLIC_MIRA_REGISTRY_PUBLIC_JWK
    ? JSON.parse(import.meta.env.PUBLIC_MIRA_REGISTRY_PUBLIC_JWK)
    : null;
} catch {
  throw new Error('PUBLIC_MIRA_REGISTRY_PUBLIC_JWK must be valid JSON');
}
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Mira Machine — A Living Mars Mystery</title>
    <meta name="description" content="A Mars mystery where you combine fragments and Mira discovers the truth." />
  </head>
  <body>
    <script is:inline define:vars={{ registryEndpoint, registryPublicKey, basePath }}>
      window.__MIRA_BASE_URL__ = basePath;
      if (!window.__MIRA_REGISTRY_CONFIG__ && registryEndpoint && registryPublicKey) {
        window.__MIRA_REGISTRY_CONFIG__ = { endpoint: registryEndpoint, publicKeyJwk: registryPublicKey };
      }
    </script>
    <main class="app">

      <!-- The chat — the game -->
      <section class="chat-shell" aria-label="Conversation with Mira">
        <header class="chat-head">
          <div class="mira-id"><span class="mira-orb" aria-hidden="true"></span><strong>Mira</strong></div>
          <div class="chat-controls">
            <div class="local-ai-control">
              <button class="gpu-toggle" id="gpuToggle" type="button" aria-describedby="localAiSummary">Use local AI</button>
              <button class="local-ai-info" id="localAiInfo" type="button" aria-label="What is Local Mira?">i</button>
            </div>
            <a class="privacy-link" href={`${basePath}privacy`}>Privacy</a>
            <button class="reset-btn" id="resetRun" type="button" aria-label="restart conversation" title="Restart">↺</button>
          </div>
        </header>
        <div class="investigation-strip" aria-live="polite">
          <div class="investigation-focus"><span>Current question</span><strong id="currentQuestion">Why do the last signal and Percy’s tracks disagree?</strong><small><b>Current theory</b> <span id="currentTheory">Percy chose something over recall.</span></small></div>
          <div class="response-status"><span>Local AI</span><strong id="lastResponseSource">Not loaded</strong><small id="localAiCount">0 discoveries created</small></div>
        </div>
        <div class="lead-strip"><span>Leads</span><div id="leadPairs" aria-label="Suggested evidence pairings"></div></div>
        <dialog class="local-ai-dialog" id="localAiDialog" aria-labelledby="localAiTitle">
          <button class="dialog-close" id="localAiClose" type="button" aria-label="Close">×</button>
          <p class="dialog-kicker">Optional · private · on this device</p>
          <h2 id="localAiTitle">Local Mira</h2>
          <p id="localAiSummary">Downloads Gemma 4 and runs it in your browser with WebGPU. It creates the first result for combinations the shared archive has never seen, then follows what that result means in your investigation.</p>
          <div class="local-ai-state" aria-live="polite">
            <div class="local-ai-state-row"><strong id="localAiStatus">Not loaded</strong><span id="localAiPercent">0%</span></div>
            <div class="local-ai-track" aria-hidden="true"><span id="localAiProgress"></span></div>
            <p id="localAiDetail">Nothing has been downloaded yet.</p>
          </div>
          <ul>
            <li>The model can take several minutes to download the first time.</li>
            <li>Inference stays on this device. A first valid pair result is saved so everyone receives that same result afterward.</li>
            <li>Google Chrome is recommended. Open Mira over HTTPS or at <code>127.0.0.1</code>.</li>
          </ul>
          <details class="webgpu-help">
            <summary>Linux PC setup</summary>
            <p>Do these steps once before downloading the model:</p>
            <ol>
              <li>Copy <code>chrome://flags/#enable-unsafe-webgpu</code>, paste it into a new Chrome tab, and change the setting to <strong>Enabled</strong>.</li>
              <li>Copy <code>chrome://flags/#enable-vulkan</code>, paste it into a new Chrome tab, and change that setting to <strong>Enabled</strong>.</li>
              <li>Click <strong>Relaunch</strong> at the bottom of Chrome. Return to Mira and try again.</li>
            </ol>
          </details>
          <button class="dialog-action" id="localAiAction" type="button">Download local model</button>
        </dialog>
        <div class="chat" id="chatScroll" aria-live="polite"></div>
      </section>

      <!-- Artifact sidebar — like Infinite Craft's item list -->
      <aside class="sidebar">
        <div class="sidebar-head">
          <span class="sidebar-title" id="fragmentsTitle">Fragments</span>
          <button class="filter-toggle" id="filterToggle" type="button">hide exhausted</button>
        </div>
        <div class="sidebar-items" id="artifacts"></div>
      </aside>

    </main>

    <style is:global>
      :root{
        color-scheme:dark;
        --rust:#b85f35; --night:#09070d; --blue:#73d9ff; --gold:#f4bd6f;
        --cream:#ffe1a0; --ghost:#9ff4ff; --green:#9cf0b4;
      }
      *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
      html,body{height:100%;overflow:hidden;background:var(--night);color:#ffe9c7;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",system-ui,sans-serif}
      body{background:radial-gradient(circle at 30% 8%,rgba(115,217,255,.06),transparent 40%),radial-gradient(circle at 74% 18%,rgba(244,189,111,.06),transparent 30%),#09070d}

      .app{display:grid;grid-template-columns:minmax(0,1fr) 280px;height:100dvh;max-width:1180px;margin:0 auto;position:relative;border-inline:1px solid rgba(244,189,111,.06)}

      .chat-shell{min-width:0;min-height:0;display:flex;flex-direction:column;overflow:hidden}
      .chat-head{height:54px;flex:0 0 54px;display:flex;align-items:center;justify-content:space-between;padding:0 16px;border-bottom:1px solid rgba(244,189,111,.1);background:rgba(9,7,13,.72);backdrop-filter:blur(10px);z-index:5}
      .mira-id,.chat-controls{display:flex;align-items:center;gap:10px}.mira-id strong{font-size:13px;letter-spacing:.04em}.mira-orb{width:18px;height:18px;border-radius:50%;background:radial-gradient(circle at 35% 30%,#fff6ce 0 8%,#73d9ff 18%,#24354f 52%,#09070d 72%);box-shadow:0 0 15px rgba(115,217,255,.4)}
      .investigation-strip{display:flex;justify-content:space-between;gap:20px;padding:9px 16px 8px;background:rgba(115,217,255,.025)}.investigation-strip>div{min-width:0;display:flex;flex-direction:column;gap:2px}.investigation-strip span,.lead-strip>span{font-size:9px;line-height:1;text-transform:uppercase;letter-spacing:.12em;color:rgba(159,244,255,.5)}.investigation-strip strong{font-size:12px;line-height:1.3;font-weight:550;color:#ffe9c7}.investigation-focus small{margin-top:2px;font-size:10px;line-height:1.3;color:rgba(255,225,160,.62)}.investigation-focus small b{margin-right:4px;color:rgba(255,225,160,.4);font-size:8px;text-transform:uppercase;letter-spacing:.09em}.investigation-focus small span{font-size:10px;line-height:inherit;text-transform:none;letter-spacing:0;color:inherit}.response-status{text-align:right;align-items:flex-end;flex:0 0 auto}.response-status small{font-size:9px;color:rgba(156,240,180,.58)}
      .lead-strip{display:flex;align-items:center;gap:10px;padding:0 16px 9px;border-bottom:1px solid rgba(115,217,255,.12);background:rgba(115,217,255,.025)}#leadPairs{min-width:0;display:flex;gap:6px;overflow-x:auto;scrollbar-width:none}#leadPairs::-webkit-scrollbar{display:none}.lead-pair{flex:0 0 auto;min-height:44px;padding:5px 10px;border:1px solid rgba(115,217,255,.2);border-radius:999px;background:rgba(115,217,255,.05);color:rgba(255,233,199,.78);font-size:10px;cursor:pointer}.lead-pair:hover,.lead-pair:focus-visible{border-color:rgba(115,217,255,.55);color:#fff2cf;background:rgba(115,217,255,.1)}.lead-pair:disabled{opacity:.45;cursor:wait}

      /* Chat — fills the left, scrolls */
      .chat{min-height:0;flex:1;overflow-y:auto;overflow-x:hidden;padding:20px clamp(16px,4vw,52px) 80px;display:flex;flex-direction:column;gap:10px;scroll-behavior:smooth}
      .chat::-webkit-scrollbar{width:0}

      /* Mira's messages — left aligned, like receiving a text */
      .chat-entry{
        max-width:min(76%,640px);padding:11px 15px;border-radius:18px 18px 18px 4px;
        line-height:1.5;font-size:15px;animation:msgIn .3s ease both;
        align-self:flex-start;word-wrap:break-word;
      }
      .chat-entry.mira,.chat-entry.discovery,.chat-entry.answer{background:rgba(255,255,255,.055);border:1px solid rgba(255,255,255,.09);color:#ffe9c7}

      .chat-entry.system{padding:4px 2px;background:transparent;border:0;color:rgba(255,225,160,.5);font-size:12px;font-style:italic}
      .chat-entry.branch{background:rgba(255,255,255,.065);border:1px solid rgba(244,189,111,.26);border-left:3px solid var(--gold);color:#fff2cf;box-shadow:0 0 18px rgba(244,189,111,.04)}
      @keyframes msgIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}

      /* Player's "sent" bubble — right aligned */
      .chat-entry.sent{
        align-self:flex-end;background:rgba(115,217,255,.08);border:1px solid rgba(115,217,255,.12);
        border-radius:18px 18px 4px 18px;color:rgba(255,233,199,.7);font-size:13px;
        max-width:60%;padding:8px 13px;
      }
      .chat-entry.evidence-pair{display:flex;gap:6px;max-width:78%;padding:7px;background:rgba(115,217,255,.045)}
      .sent-fragment{display:flex;align-items:center;gap:6px;min-width:0;padding:7px 9px;border:1px solid rgba(115,217,255,.18);border-radius:10px;background:rgba(115,217,255,.055)}
      .sent-fragment span:last-child{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

      /* Typing indicator */
      .typing{align-self:flex-start;display:flex;gap:5px;padding:14px 18px;background:rgba(255,225,160,.04);border:1px solid rgba(244,189,111,.08);border-radius:18px 18px 18px 4px}
      .typing span{width:7px;height:7px;border-radius:50%;background:var(--gold);opacity:.4;animation:dotPulse 1.3s ease-in-out infinite}
      .typing span:nth-child(2){animation-delay:.2s}
      .typing span:nth-child(3){animation-delay:.4s}
      @keyframes dotPulse{0%,100%{opacity:.3;transform:scale(.8)}50%{opacity:1;transform:scale(1.1)}}

      /* Sidebar — Infinite Craft style item list */
      .sidebar{border-left:1px solid rgba(244,189,111,.1);background:rgba(9,7,13,.5);display:flex;flex-direction:column;overflow:hidden}
      .sidebar-head{display:flex;align-items:center;justify-content:space-between;padding:10px 12px;border-bottom:1px solid rgba(244,189,111,.08)}
      .sidebar-title{font-size:11px;text-transform:uppercase;letter-spacing:.12em;color:rgba(255,225,160,.5)}
      .filter-toggle{font-size:10px;min-height:44px;padding:5px 12px;border:1px solid rgba(244,189,111,.2);background:rgba(0,0,0,.2);color:rgba(255,225,160,.62);border-radius:999px;cursor:pointer}
      .filter-toggle.active{color:var(--green);border-color:rgba(156,240,180,.4);background:rgba(156,240,180,.06)}
      .sidebar-items{flex:1;overflow-y:auto;padding:8px;display:flex;flex-direction:column;gap:6px}
      .sidebar-items::-webkit-scrollbar{width:3px}
      .sidebar-items::-webkit-scrollbar-thumb{background:rgba(244,189,111,.2);border-radius:999px}

      .artifact{
        display:flex;align-items:center;gap:7px;text-align:left;
        border:1px solid rgba(255,255,255,.14);
        background:rgba(255,255,255,.045);
        border-radius:12px;padding:8px 10px;cursor:pointer;width:100%;min-height:48px;
        transition:transform .12s ease,box-shadow .12s ease,border-color .12s ease,opacity .2s ease;
        box-shadow:0 3px 10px rgba(0,0,0,.3);
      }
      .artifact:hover{transform:translateX(2px);border-color:rgba(115,217,255,.5);background:rgba(115,217,255,.055)}
      .artifact:disabled{cursor:wait;opacity:.58}
      .artifact.selected{transform:translateX(4px) scale(1.02);box-shadow:0 0 16px rgba(115,217,255,.18);border-color:var(--blue);background:rgba(115,217,255,.1)}
      .artifact.tried{opacity:.34;filter:saturate(.4)}
      .artifact.pair-tried{opacity:.46;border-style:dashed}.artifact.pair-tried::after{content:'TRIED';font-size:8px;letter-spacing:.08em;color:rgba(255,225,160,.52);margin-left:auto}
      .artifact.hidden{display:none}
      .artifact .icon{font-size:16px;line-height:1;width:20px;text-align:center;flex-shrink:0;color:rgba(159,244,255,.8)}
      .artifact .info{min-width:0;display:flex;flex:1;flex-direction:column;gap:2px}
      .artifact .name{font-size:12px;font-weight:500;color:#ffe9c7;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
      .artifact .prop{font-size:11px;color:rgba(255,225,160,.62);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
      .artifact.newborn{border-color:rgba(244,189,111,.6);animation:birth .6s cubic-bezier(.25,.1,.25,1.4) both}
      .artifact.is-new::after{content:'new';margin-left:auto;color:var(--gold);font-size:9px;text-transform:uppercase;letter-spacing:.1em}
      @keyframes birth{0%{transform:scale(.3) rotate(-8deg);opacity:0}70%{transform:scale(1.1)}100%{transform:scale(1);opacity:1}}

      /* GPU toggle */
      .gpu-toggle{
        min-height:44px;padding:6px 12px;border:1px solid rgba(156,240,180,.3);background:rgba(9,7,13,.8);
        color:rgba(156,240,180,.7);border-radius:999px;font-size:11px;cursor:pointer;
        backdrop-filter:blur(8px);transition:all .2s ease;
      }
      .gpu-toggle:hover{color:var(--green);border-color:rgba(156,240,180,.5)}
      .gpu-toggle.loading{color:var(--gold);border-color:rgba(244,189,111,.4)}
      .gpu-toggle.ready{color:var(--green);border-color:rgba(156,240,180,.5);background:rgba(156,240,180,.06)}
      .local-ai-control{display:flex;align-items:center;gap:4px;flex-shrink:0}.local-ai-info{width:44px;height:44px;flex:0 0 44px;border-radius:50%;border:1px solid rgba(156,240,180,.3);background:rgba(9,7,13,.8);color:var(--green);cursor:pointer;font:600 13px/1 Georgia,serif}
      .local-ai-dialog{position:fixed;inset:0;margin:auto;width:min(calc(100vw - 32px),440px);max-height:min(86dvh,620px);overflow:auto;border:1px solid rgba(244,189,111,.2);border-radius:16px;padding:28px;background:linear-gradient(180deg,rgba(20,17,26,.98),rgba(11,9,15,.99));color:#ffe9c7;box-shadow:0 24px 80px rgba(0,0,0,.72),0 0 0 1px rgba(115,217,255,.04);}.local-ai-dialog::backdrop{background:rgba(4,3,8,.78);backdrop-filter:blur(8px)}
      .local-ai-dialog h2{font:600 clamp(25px,5vw,34px)/1.05 Georgia,serif;margin:4px 0 12px}.local-ai-dialog>p{line-height:1.55;color:rgba(255,233,199,.78)}.dialog-kicker{text-transform:uppercase;letter-spacing:.14em;font-size:10px!important;color:var(--green)!important}.dialog-close{position:absolute;right:14px;top:12px;width:44px;height:44px;border:0;background:transparent;color:#ffe9c7;font-size:25px;cursor:pointer}.local-ai-state{margin:18px 0;padding:14px;border:1px solid rgba(115,217,255,.16);border-radius:12px;background:rgba(115,217,255,.04)}.local-ai-state-row{display:flex;justify-content:space-between;gap:16px;font-size:12px}.local-ai-track{height:6px;margin:10px 0;background:rgba(255,255,255,.08);border-radius:99px;overflow:hidden}.local-ai-track span{display:block;width:0;height:100%;background:linear-gradient(90deg,var(--blue),var(--green));transition:width .2s ease}.local-ai-state p{font-size:12px!important;margin:0;color:rgba(255,233,199,.62)!important}.local-ai-dialog ul{margin:14px 0 18px;padding-left:20px;color:rgba(255,233,199,.7);font-size:12px;line-height:1.5}.webgpu-help{margin:0 0 18px;padding:12px 14px;border:1px solid rgba(244,189,111,.2);border-radius:12px;background:rgba(244,189,111,.04);font-size:12px;line-height:1.5}.webgpu-help summary{min-height:44px;display:flex;align-items:center;color:var(--gold);font-weight:700;cursor:pointer}.webgpu-help p{margin:4px 0 8px;color:rgba(255,233,199,.72)}.webgpu-help ol{margin:0;padding-left:20px;color:rgba(255,233,199,.72)}.webgpu-help li+li{margin-top:8px}.webgpu-help code{overflow-wrap:anywhere;color:var(--blue)}.dialog-action{width:100%;min-height:48px;border:1px solid rgba(156,240,180,.45);border-radius:999px;background:rgba(156,240,180,.09);color:var(--green);font-weight:700;cursor:pointer}

      .privacy-link{min-width:44px;min-height:44px;display:inline-flex;align-items:center;justify-content:center;color:rgba(255,225,160,.58);font-size:10px;text-decoration:none;text-transform:uppercase;letter-spacing:.08em}
      .privacy-link:hover{color:var(--cream)}

      .reset-btn{width:44px;height:44px;flex:0 0 44px;border:1px solid rgba(244,189,111,.2);background:rgba(9,7,13,.8);color:rgba(255,225,160,.5);border-radius:50%;font-size:14px;cursor:pointer;backdrop-filter:blur(8px)}
      .reset-btn:hover{color:var(--cream);border-color:rgba(244,189,111,.5)}

      @media(max-width:680px){
        .investigation-strip{gap:10px;padding-inline:12px}.investigation-strip strong{font-size:11px}.response-status small{display:none}.investigation-focus small{font-size:9px}.lead-strip{padding-inline:12px}.lead-pair{min-height:44px}
        .app{grid-template-columns:1fr;grid-template-rows:1fr auto}
        .chat-head{height:56px;flex-basis:56px;padding:0 10px}.gpu-toggle{font-size:10px;min-height:44px}.reset-btn{width:44px;height:44px}
        .chat{padding:16px 16px 54px}.chat-entry{max-width:88%}.chat-entry.sent{max-width:80%}
        .sidebar{border-left:none;border-top:2px solid rgba(115,217,255,.16);height:min(36dvh,286px);max-height:none;background:rgba(14,12,19,.96);box-shadow:0 -10px 28px rgba(0,0,0,.32)}.filter-toggle{min-height:44px;padding-inline:12px}
        .sidebar-items{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));align-content:start;overflow-x:hidden;overflow-y:auto;padding:8px;gap:8px}
        .artifact{width:100%;min-width:0;min-height:56px;align-items:flex-start}
        .artifact .name,.artifact .prop{white-space:normal;display:-webkit-box;-webkit-box-orient:vertical;overflow:hidden}.artifact .name{-webkit-line-clamp:1}.artifact .prop{-webkit-line-clamp:2;line-height:1.25}
        .chat-entry.evidence-pair{max-width:92%;flex-wrap:wrap}.sent-fragment{max-width:100%}
      }
      @media(max-width:360px){.mira-id strong{display:none}.chat-controls{gap:6px}.chat-head{padding-inline:8px}}
      @media(prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;scroll-behavior:auto!important;transition-duration:.01ms!important}}
      :focus-visible{outline:2px solid var(--blue);outline-offset:3px}
    </style>

    <script type="module">
      // ===== Optional browser-local Gemma 4 =====
      var gpuToggle = document.getElementById('gpuToggle');
      var localAiDialog = document.getElementById('localAiDialog');
      var localAiInfo = document.getElementById('localAiInfo');
      var localAiClose = document.getElementById('localAiClose');
      var localAiAction = document.getElementById('localAiAction');
      var localAiStatus = document.getElementById('localAiStatus');
      var localAiPercent = document.getElementById('localAiPercent');
      var localAiProgress = document.getElementById('localAiProgress');
      var localAiDetail = document.getElementById('localAiDetail');
      var LOCAL_MIRA_GAME_VERSION = 'mira-chat-v10-growing-story';
      function setLocalAiState(label, detail, pct){
        var value = Math.max(0, Math.min(100, Number(pct)||0));
        localAiStatus.textContent = label; localAiDetail.textContent = detail;
        localAiPercent.textContent = value + '%'; localAiProgress.style.width = value + '%';
      }
      function openLocalAiDialog(){
        if (!localAiDialog.open) localAiDialog.showModal();
      }
      function parseLocalModelResult(res,prompt){
        var text=typeof res==='string'?res:(Array.isArray(res)?res[0]&&res[0].generated_text:res&&res.generated_text)||'';
        if(text.indexOf(prompt)>=0)text=text.slice(text.lastIndexOf(prompt)+prompt.length);
        text=text.replace(/```json|```/g,'').trim();
        var parsed=null;
        try{parsed=JSON.parse(text);}catch(e){var start=text.indexOf('{'),end=text.lastIndexOf('}');if(start>=0&&end>start)try{parsed=JSON.parse(text.slice(start,end+1));}catch(ignore){}}
        if(!parsed||!parsed.mira)throw new Error('Local AI returned no readable JSON response');
        parsed.mira=String(parsed.mira).replace(/^Mira:\s*/i,'').replace(/\s+/g,' ').trim().slice(0,180);
        if(parsed.question)parsed.question=String(parsed.question).replace(/\s+/g,' ').trim().slice(0,90);
        return parsed;
      }
      localAiInfo.addEventListener('click', openLocalAiDialog);
      localAiClose.addEventListener('click', function(){ localAiDialog.close(); });
      localAiAction.addEventListener('click', startLocalMira);
      window.__openLocalAiDialog = openLocalAiDialog;
      var testParams = new URLSearchParams(location.search);
      window.__miraRegistryReady = Promise.resolve(null);
      if (window.__MIRA_REGISTRY_CONFIG__) {
        window.__miraRegistryReady = import(window.__MIRA_BASE_URL__ + 'registry-client.js').then(function(mod){
          return mod.installMiraRegistry(Object.assign({}, window.__MIRA_REGISTRY_CONFIG__, {gameVersion:LOCAL_MIRA_GAME_VERSION}));
        }).catch(function(error){ console.warn('Shared discovery registry unavailable:', error && error.message ? error.message : error); return null; });
      }
      if ((location.hostname === '127.0.0.1' || location.hostname === 'localhost') && testParams.get('ollama') === '1') {
        import(window.__MIRA_BASE_URL__ + 'ollama-mira-test.js').then(function(mod){
          mod.installOllamaMira({ endpoint: testParams.get('ollamaEndpoint') || 'http://127.0.0.1:11434', model: testParams.get('ollamaModel') || 'gemma4:latest' });
          gpuToggle.classList.add('ready');
          gpuToggle.textContent = 'Local AI ready';
          gpuToggle.title = 'Gemma 4 is running locally through the test adapter';
          gpuToggle.disabled = true;
          setLocalAiState('Ready', 'Gemma 4 is connected through the local test adapter.', 100);
        }).catch(function(error){
          console.error('Ollama test adapter failed:', error);
          gpuToggle.textContent = 'Story mode';
          setLocalAiState('Unavailable', 'The local test adapter could not connect.', 0);
        });
      }

      gpuToggle.addEventListener('click', function(){
        if (!gpuToggle.classList.contains('ready') && !gpuToggle.classList.contains('loading')) openLocalAiDialog();
      });

      async function startLocalMira(){
        if (gpuToggle.classList.contains('ready') || gpuToggle.classList.contains('loading')) return;
        if (!navigator.gpu) {
          gpuToggle.textContent = 'Story mode';
          gpuToggle.title = 'Local AI needs WebGPU and HTTPS. The authored mystery remains fully playable.';
          if (typeof window.statusMessage === 'function') window.statusMessage('Local Mira needs WebGPU and HTTPS. Story mode keeps the authored investigation fully playable.');
