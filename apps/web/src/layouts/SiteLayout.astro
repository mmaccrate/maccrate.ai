---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const { title, description, image = '/og.png', type = 'website', jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, 'https://maccrate.ai');
const pageTitle = title === 'maccrate.ai' ? 'maccrate.ai — Working prototypes by Max' : `${title} — maccrate.ai`;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#f1eadb" />
  <meta name="color-scheme" content="light" />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate icon" href="/favicon.ico" />
  <meta property="og:type" content={type} />
  <meta property="og:site_name" content="maccrate.ai" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL(image, 'https://maccrate.ai')} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(image, 'https://maccrate.ai')} />
  <title>{pageTitle}</title>
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <div class="site-shell">
    <header class="site-head">
      <a class="wordmark" href="/" aria-label="maccrate.ai home">maccrate.ai</a>
      <span class="brand-purpose">Engineer · learning by building</span>
      <nav class="site-nav" aria-label="Primary navigation">
        <a href="/" aria-current={path === '/' ? 'page' : undefined}>Projects</a>
        <a href="/about" aria-current={path === '/about' ? 'page' : undefined}>About</a>
      </nav>
      <a class="contact-link" href="/about#contact">Contact</a>
    </header>
    <main class="page-main" id="main"><slot /></main>
    <footer class="site-foot">
      <div>
        <strong>maccrate.ai</strong><br />
        © {new Date().getFullYear()} Max MacCrate
      </div>
      <nav class="footer-links" aria-label="Footer navigation">
        <a href="/about#contact">Contact</a>
        <a href="/about">About</a>
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
      </nav>
    </footer>
  </div>
</body>
</html>
