---
import SiteLayout from '../layouts/SiteLayout.astro';
import ReleaseCover from '../components/ReleaseCover.astro';
import { PROJECTS, projectNumber } from '../data/projects';
import { MAX_PERSON, MAX_PERSON_REFERENCE, SITE_URL, WEBSITE_ID } from '../data/site';
const orderedProjects = [...PROJECTS].sort((a, b) => b.sequence - a.sequence);
const description = "Max MacCrate's personal site for engineering projects, experiments, and technical work.";
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': WEBSITE_ID,
    name: 'maccrate.ai',
    url: SITE_URL,
    description,
    publisher: MAX_PERSON_REFERENCE,
    creator: MAX_PERSON_REFERENCE,
  },
  MAX_PERSON,
];
---
<SiteLayout title="Max MacCrate" description={description} jsonLd={jsonLd}>
  <div class="project-shelf" aria-label="Projects">
    {orderedProjects.map((project, index) => <>
      {index > 0 && <div class="project-divider" aria-hidden="true"></div>}
      <article class:list={['project-panel', { reverse: index % 2 === 1 }]} aria-labelledby={`project-${project.slug}`}>
      <div class="project-copy">
        <p class="release-meta"><span>Build {projectNumber(project.sequence)}</span><span>{project.year}</span></p>
        {index === 0
          ? <h1 class="display" id={`project-${project.slug}`} aria-describedby="site-identity">{project.title}</h1>
          : <h2 class="display" id={`project-${project.slug}`}>{project.title}</h2>}
        <p class="descriptor">{project.descriptor}</p>
        <p class="premise">{project.premise}</p>
        <div class="actions">
          {project.liveUrl && <a class="button-link" href={project.liveUrl} target="_blank" rel="noopener noreferrer">{project.slug === 'browser-lora-cartridges' ? 'Open Model Cartridges' : `Play ${project.title}`} <span aria-hidden="true">↗</span></a>}
          <a class:list={[project.liveUrl ? 'notes' : 'button-link']} href={`/projects/${project.slug}`}>{project.liveUrl ? `Read about ${project.title}` : `Read the ${project.title} field report`} <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <ReleaseCover project={project} linked />
    </article>
    </>)}
  </div>
</SiteLayout>
<style>
.project-shelf{padding-bottom:0}.project-divider{width:100%;height:1px;margin:0;background:var(--ink)}
.project-panel{display:grid;grid-template-columns:minmax(300px,.8fr) minmax(400px,1.2fr);gap:clamp(56px,9vw,130px);align-items:center;min-height:0;padding:36px 0}
.project-panel:last-child{padding-bottom:28px}.project-panel.reverse .project-copy,.project-panel.reverse :global(.release-cover){order:initial}
.project-copy{min-width:0;padding-left:clamp(0px,3vw,48px);padding-right:clamp(8px,1.5vw,22px)}.reverse .project-copy{padding-left:clamp(0px,3vw,48px);padding-right:clamp(8px,1.5vw,22px)}
.release-meta{display:flex;justify-content:space-between;gap:20px;margin:0 0 30px;padding:0;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.14em}
.project-copy h1,.project-copy h2{margin:0;font-size:clamp(58px,7.4vw,112px);line-height:.9;letter-spacing:-.055em}.descriptor{margin:24px 0 0;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.12em;color:var(--muted)}
.premise{max-width:520px;margin:30px 0 27px;font-size:clamp(18px,1.55vw,24px);line-height:1.4}.actions{display:flex;align-items:center;gap:22px;flex-wrap:wrap}.notes{font-size:12px;font-weight:700;text-underline-offset:4px}
:global(.site-foot){margin-top:0}
@media(max-width:800px){.project-panel,.project-panel.reverse{grid-template-columns:1fr;gap:32px;min-height:0;padding:28px 0}.project-panel:last-child{padding-bottom:22px}.project-panel .project-copy,.project-panel.reverse .project-copy{order:2;padding:0}.project-panel :global(.release-cover),.project-panel.reverse :global(.release-cover){order:1}.project-copy h1,.project-copy h2{font-size:clamp(58px,18vw,105px)}}
</style>
