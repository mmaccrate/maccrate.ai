---
import SiteLayout from '../layouts/SiteLayout.astro';
---
<SiteLayout title="Not found" description="The requested page was not found on maccrate.ai.">
<section class="missing"><p class="eyebrow">Off the record · 404</p><h1 class="display">That release<br />isn’t in the crate.</h1><p>The page may have moved, or it was never published.</p><a class="button-link" href="/#catalog">Return to the catalog →</a></section>
</SiteLayout>
<style>.missing{min-height:68vh;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;padding:60px 0}.missing h1{margin:0;font-size:clamp(64px,10vw,150px)}.missing>p:not(.eyebrow){font-size:clamp(17px,1.5vw,23px);margin:36px 0 24px}</style>
