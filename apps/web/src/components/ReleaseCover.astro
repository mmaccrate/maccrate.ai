---
import type { Project } from '../data/projects';
import { projectNumber } from '../data/projects';
interface Props { project: Project; compact?: boolean; linked?: boolean; }
const { project, compact = false, linked = false } = Astro.props;
const Tag = linked ? 'a' : 'div';
const href = linked ? `/projects/${project.slug}` : undefined;
const titleWords = project.title.toUpperCase().split(/\s+/);
---
<Tag class:list={['release-cover', `cover-${project.cover}`, { compact }]} href={href} style={`--accent:${project.accent};view-transition-name:cover-${project.slug}`} aria-label={linked ? `View ${project.title} case study` : undefined}>
  <span class="cover-band" aria-hidden="true"></span>
  <span class="catalog-number">MC–{projectNumber(project.sequence)}</span>
  <span class="cover-orbit orbit-one" aria-hidden="true"></span>
  <span class="cover-orbit orbit-two" aria-hidden="true"></span>
  {project.cover === 'mira' && <span class="cover-sample" aria-hidden="true"><i></i></span>}
  <span class="cover-title" aria-hidden="true">{titleWords.map((word) => <b>{word}</b>)}</span>
  <span class="cover-caption">{project.descriptor}</span>
</Tag>

<style>
.release-cover{position:relative;display:block;aspect-ratio:1/1;overflow:hidden;background:var(--accent);color:#f1eadb;isolation:isolate;text-decoration:none;transition:transform .18s ease,filter .18s ease}
.release-cover:focus-visible{outline:4px solid #141210;outline-offset:5px}
.release-cover[href]:hover{transform:translateY(-3px);filter:saturate(1.08)}
.cover-band{position:absolute;inset:0 0 auto;height:27%;background:#e9ff52;z-index:-1}
.catalog-number{position:absolute;top:5%;left:5%;color:#141210;font-size:clamp(10px,1vw,15px);font-weight:700;letter-spacing:.14em}
.cover-title{position:absolute;left:4.5%;top:31%;display:flex;flex-direction:column;font-family:Arial,Helvetica,sans-serif;font-size:clamp(48px,7.1vw,118px);font-weight:900;line-height:.73;letter-spacing:-.08em;mix-blend-mode:screen}
.cover-title b:last-child{transform:translateX(.31em)}
.cover-geometric .cover-title{font-size:clamp(42px,5.8vw,92px);line-height:.92;letter-spacing:-.065em;row-gap:6px}
.cover-geometric .cover-title b:last-child{font-size:.76em;transform:none}
.cover-caption{position:absolute;left:5%;bottom:5%;padding-top:7px;border-top:1px solid currentColor;font-size:clamp(9px,.95vw,14px);text-transform:uppercase;letter-spacing:.12em}
.cover-sample{position:absolute;right:11%;top:16%;width:29%;aspect-ratio:1;border-radius:50%;background:#91d6ff;box-shadow:inset -22px -22px 44px rgba(0,15,77,.28),0 0 0 2px rgba(241,234,219,.7);animation:breathe 5s ease-in-out infinite}
.cover-sample i{position:absolute;width:28%;aspect-ratio:1;left:26%;top:24%;border-radius:50%;background:rgba(255,255,255,.8);filter:blur(3px)}
.cover-orbit{position:absolute;border:1px solid rgba(241,234,219,.58);border-radius:50%}.orbit-one{right:-8%;top:8%;width:68%;height:46%;transform:rotate(-17deg)}.orbit-two{right:-17%;top:28%;width:82%;height:54%;transform:rotate(17deg)}
.compact .cover-title{font-size:clamp(36px,5vw,72px)}.compact .cover-caption{font-size:9px}
@keyframes breathe{50%{transform:scale(1.035);filter:saturate(1.2)}}
@media(max-width:760px){.cover-title,.compact .cover-title{font-size:17vw}.cover-geometric .cover-title,.cover-geometric.compact .cover-title{font-size:14vw;line-height:.94}.cover-caption{font-size:9px}}
@media(prefers-reduced-motion:reduce){.cover-sample{animation:none}.release-cover{transition:none}}
</style>
